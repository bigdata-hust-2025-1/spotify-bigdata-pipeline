# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
.venv/
venv/
env/

.vscode/

# JetBrains IDE
.idea/

# Generated pipeline data — never commit Bronze/Silver/Gold output, exports, or
