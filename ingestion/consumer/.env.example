# ==========================================================================
# Consumer (Kafka -> MinIO) configuration TEMPLATE.
#
# HOW TO USE:  cp .env.example .env  and fill in your own values.
# The real .env is gitignored and MUST NOT be committed. See docs/SECRETS.md
# for the rotation runbook and where runtime secrets live in production.
# ==========================================================================

# --- Kafka ------------------------------------------------------------------
# Use the external listener when running outside Minikube (e.g. localhost:19092).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- MinIO / S3 object store ------------------------------------------------
# MINIO_ENDPOINT is the host:port of the MinIO API (port-forward or in-cluster
# service). ROOT_USER / ROOT_PASSWORD are SECRETS — never commit real values.
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=your_minio_access_key_here
MINIO_ROOT_PASSWORD=your_minio_secret_key_here

# Uncomment if MinIO is served over HTTPS.
# MINIO_SECURE=True
