# .env
KAFKA_BOOTSTRAP_SERVERS=localhost:19092          # Dùng port EXTERNAL bạn đã config trước đó

MINIO_ENDPOINT=localhost:9000                    # Port-forward MinIO console
MINIO_ROOT_USER=minioadmin                  # Từ minio.yaml
MINIO_ROOT_PASSWORD=miniopass123

# Nếu MinIO dùng secure=True (HTTPS), thêm:
# MINIO_SECURE=True