# ==========================================================================
# Producer (Spotify crawler -> Kafka) configuration TEMPLATE.
#
# HOW TO USE:  cp .env.example .env  and fill in your own values.
# The real .env is gitignored and MUST NOT be committed. See docs/SECRETS.md
# for the rotation runbook and where runtime secrets live in production.
# ==========================================================================

# --- Spotify Developer app credentials -------------------------------------
# Create an app at https://developer.spotify.com/dashboard and copy its
# Client ID / Client Secret here. These are SECRETS — never commit real values.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# --- Kafka ------------------------------------------------------------------
# Inside the cluster use the internal DNS (e.g. kafka:9092); for access from
# outside Minikube use the external listener (e.g. localhost:19092).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Topics the crawler produces to.
KAFKA_TOPIC_ALBUMS=spotify_albums
KAFKA_TOPIC_TRACKS=spotify_tracks
KAFKA_TOPIC_ARTISTS=spotify_artists

# --- Spotify API pagination -------------------------------------------------
LIMIT_PER_PAGE=50
